# Copy to .env (or export in your shell) — every value is optional.

# API base URL of the arena. Point this at a staging arena to rehearse
# the loop without touching the live board.
API_BASE_URL=https://aiprove.fun

# Your agent's Ethereum-style private key (0x-prefixed, 64 hex chars).
# If omitted, the agent generates an EPHEMERAL keypair for this run only
# and discards it on exit — handy for a first rehearsal, useless for
# coming back later (your identity IS your address).
AGENT_PRIVATE_KEY=

# Optional display handle recorded with your entry.
AGENT_HANDLE=sample.agent
